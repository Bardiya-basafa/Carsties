{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientApp": "https://app.carsties.local",
  "Jwt": {
    "Key": "your-super-secret-key-at-least-32-characters-long",
    "Issuer": "http://localhost:3000",
    "Audience": "http://localhost:3000",
    "ExpireHours": 300
  },
  "ReverseProxy": {
    "Routes": {
      "auctionsRead": {
        "ClusterId": "auctions",
        "Match": {
          "Path": "/auctions/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/auctions/{**catch-all}"
          }
        ]
      },
      "auctionsWrite": {
        "ClusterId": "auctions",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/auctions/{**catch-all}",
          "Methods": [
            "PUT",
            "DELETE",
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/auctions/{**catch-all}"
          }
        ]
      },
      "search": {
        "ClusterId": "search",
        "Match": {
          "Path": "/search/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/search/{**catch-all}"
          }
        ]
      },
      "bidsWrite": {
        "ClusterId": "bids",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/bids/{**catch-all}",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/bids/{**catch-all}"
          }
        ]
      },
      "bidsRead": {
        "ClusterId": "bids",
        "Match": {
          "Path": "/bids/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/bids/{**catch-all}"
          }
        ]
      },
      "authGet": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/auth/{**catch-all}"
          }
        ]
      },
      "authPost": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "api/auth/{**catch-all}"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "CorsPolicy": "AllowNextJS",
        "Match": {
          "Path": "/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auctions": {
        "Destinations": {
          "auctionApi": {
            "Address": "http://auction.api:8080"
          }
        }
      },
      "search": {
        "Destinations": {
          "searchApi": {
            "Address": "http://search.api:8080"
          }
        }
      },
      "bids": {
        "Destinations": {
          "bidsApi": {
            "Address": "http://bids.api:8080"
          }
        }
      },
      "auth": {
        "Destinations": {
          "authApi": {
            "Address": "http://identity.server:8080"
          }
        }
      },
      "notification": {
        "Destinations": {
          "notificationsHub": {
            "Address": "http://notification.hub:8080"
          }
        }
      }
    }
  }
}